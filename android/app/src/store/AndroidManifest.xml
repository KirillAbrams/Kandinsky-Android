<!-- Убирает разрешение на замеры через командную оболочку в сборке для магазина. Внутренняя сборка для измерений может сохранить его. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <profileable tools:node="remove"/>
    </application>
</manifest>
